<Window x:Class="RankingDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RankingDemo.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Ranking Demo"
        Height="780"
        Width="1380"
        MinHeight="700"
        MinWidth="1200">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="LineHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Padding="12"
                Margin="0,0,0,10"
                Background="#F4F6F8"
                BorderBrush="#D6DCE3"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="CSV betöltése"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Command="{Binding LoadCsvCommand}" />

                    <Button Content="Fociminta betöltése"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Command="{Binding LoadFootballSampleCommand}" />

                    <Button Content="Új kézi sor"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Command="{Binding AddManualRowCommand}" />

                    <Button Content="Kijelölt sor törlése"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Command="{Binding RemoveSelectedManualRowCommand}" />

                    <Button Content="Kézi adat aktiválása"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Command="{Binding ApplyManualDataCommand}" />
                </WrapPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource HeaderTextBlockStyle}"
                               Text="Lekérdezés:" HorizontalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Height="30"
                              Margin="0,0,16,0"
                              ItemsSource="{Binding Queries}"
                              SelectedItem="{Binding SelectedQuery}"
                              IsEditable="True"
                              IsReadOnly="True"
                              Text="{Binding SelectedQuery, TargetNullValue=Nincs aktív lekérdezés}" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource HeaderTextBlockStyle}"
                               Text="k:" HorizontalAlignment="Center"/>

                    <TextBox Grid.Column="3"
                             Height="30"
                             Margin="0,0,16,0"
                             HorizontalContentAlignment="Center"
                             Text="{Binding K}" />

                    <Button Grid.Column="4"
                            Content="Összehasonlítás futtatása"
                            Padding="12,6"
                            Command="{Binding CompareAlgorithmsCommand}" />
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#435466"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="Adatbevitel">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Itt tudsz kézzel összeállítani egy mintát. A focis példa szándékosan tartalmaz egymásnak ellentmondó mutatókat, hogy jobban látszódjon, melyik módszer hogyan súlyoz." />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ManualRows}"
                              SelectedItem="{Binding SelectedManualRow}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="QueryId" Binding="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Lekérdezés" Binding="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Width="230" />
                            <DataGridTextColumn Header="Csapat / DocId" Binding="{Binding DocId, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                            <DataGridTextColumn Header="Pont" Binding="{Binding Points, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Győzelem" Binding="{Binding Wins, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                            <DataGridTextColumn Header="Gólkül." Binding="{Binding GoalDifference, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Lőtt" Binding="{Binding GoalsFor, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Kapott" Binding="{Binding GoalsAgainst, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Relevancia" Binding="{Binding Relevance, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                            <DataGridTextColumn Header="Megjegyzés / DocText" Binding="{Binding DocText, UpdateSourceTrigger=PropertyChanged}" Width="360" MinWidth="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Elvárt sorrend">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               Text="Az aktív lekérdezéshez tartozó alapadatok, relevancia szerint rendezve. Ez adja a viszonyítási alapot a három tanítási módszerhez." />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RowsForSelectedQuery}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Csapat / DocId" Binding="{Binding DocId}" Width="140"/>
                            <DataGridTextColumn Header="Relevancia" Binding="{Binding Relevance}" Width="90"/>
                            <DataGridTextColumn Header="Pont" Binding="{Binding Points}" Width="70"/>
                            <DataGridTextColumn Header="Győzelem" Binding="{Binding Wins}" Width="85"/>
                            <DataGridTextColumn Header="Gólkül." Binding="{Binding GoalDifference}" Width="80"/>
                            <DataGridTextColumn Header="DocText" Binding="{Binding DocText}" Width="420" MinWidth="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Összehasonlítás">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Pointwise">
                        <DataGrid ItemsSource="{Binding PointwiseRankedRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50"/>
                                <DataGridTextColumn Header="Csapat" Binding="{Binding DocId}" Width="110"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                                <DataGridTextColumn Header="Rel." Binding="{Binding Relevance}" Width="55"/>
                                <DataGridTextColumn Header="Pont" Binding="{Binding Points}" Width="55"/>
                                <DataGridTextColumn Header="Gólkül." Binding="{Binding GoalDifference}" Width="65"/>
                                <DataGridTextColumn Header="Leírás" Binding="{Binding DocText}" Width="260" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Pairwise">
                        <DataGrid ItemsSource="{Binding PairwiseRankedRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50"/>
                                <DataGridTextColumn Header="Csapat" Binding="{Binding DocId}" Width="110"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                                <DataGridTextColumn Header="Rel." Binding="{Binding Relevance}" Width="55"/>
                                <DataGridTextColumn Header="Pont" Binding="{Binding Points}" Width="55"/>
                                <DataGridTextColumn Header="Gólkül." Binding="{Binding GoalDifference}" Width="65"/>
                                <DataGridTextColumn Header="Leírás" Binding="{Binding DocText}" Width="260" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="4" Header="Listwise">
                        <DataGrid ItemsSource="{Binding ListwiseRankedRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50"/>
                                <DataGridTextColumn Header="Csapat" Binding="{Binding DocId}" Width="110"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                                <DataGridTextColumn Header="Rel." Binding="{Binding Relevance}" Width="55"/>
                                <DataGridTextColumn Header="Pont" Binding="{Binding Points}" Width="55"/>
                                <DataGridTextColumn Header="Gólkül." Binding="{Binding GoalDifference}" Width="65"/>
                                <DataGridTextColumn Header="Leírás" Binding="{Binding DocText}" Width="260" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Metrikák">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Módszerek összehasonlítása" Grid.Row="0" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding MetricResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Height="160"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Módszer" Binding="{Binding Algorithm}" Width="*"/>
                                <DataGridTextColumn Header="Precision@k" Binding="{Binding PrecisionAtK, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="NDCG@k" Binding="{Binding NdcgAtK, StringFormat=F2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Precision@k vizualizáció" Grid.Row="1" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding MetricResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Algorithm}"
                                                   Margin="0,0,8,0"/>

                                        <ProgressBar Grid.Column="1"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding PrecisionAtK}"
                                                     Height="22" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PrecisionAtK, StringFormat=F2}"
                                                   HorizontalAlignment="Right"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="NDCG@k vizualizáció" Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding MetricResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Algorithm}"
                                                   Margin="0,0,8,0"/>

                                        <ProgressBar Grid.Column="1"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding NdcgAtK}"
                                                     Height="22" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NdcgAtK, StringFormat=F2}"
                                                   HorizontalAlignment="Right"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
